# Copy this file to .env and replace the placeholder with your actual key.
# .env is listed in .gitignore — never commit your real key.
#
SETUP STEPS:
#   1. Copy this file:  copy .env.example .env   (Windows)
#                       cp .env.example .env     (Mac/Linux)
#   2. Open .env and replace the placeholder with your real key
#   3. Save the file — python-dotenv loads it automatically on run
#
# The .env file is already in .gitignore — your key stays private

# REQUIRED — Get a FREE key at: https://console.groq.com
# Click "API Keys" → "Create API Key" → paste it below
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL — Reddit live scraping
# Get from: https://www.reddit.com/prefs/apps → Create App → script
# Without these, Reddit stage uses documents/reddit_reviews.txt
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
